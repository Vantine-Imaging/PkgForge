# Generated by XcodeGen — project.yml is the source of truth
/PkgForge.xcodeproj/

# Build products. Anchored to the repository root on purpose: an unanchored
# "build/" also matches PkgForge/Build/ — git sets core.ignoreCase on macOS —
# which silently excluded three source files from the repository.
/build/
/dist/
/DerivedData/

# Xcode user state
xcuserdata/
*.xcuserstate

